# Run python -m signalbrief.setup to generate random local auth secrets.
ADMIN_PASSWORD=
WEBHOOK_API_KEY=
SESSION_SECRET=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Alternatively set GROQ_API_KEY or OPENAI_API_KEY.
GROQ_API_KEY=
OPENAI_API_KEY=
ZAPIER_HOOK_URL=https://hooks.zapier.com/hooks/catch/YOUR_ACCOUNT/YOUR_HOOK/
PUBLIC_BASE_URL=http://localhost:8000
SECURE_COOKIES=false
DATABASE_PATH=data/signalbrief.sqlite3
COMPETITORS_PATH=competitors.json
MAX_DAILY_RUNS=20
